{%- comment -%}
  404.liquid — кастомная страница 404: платформа отдаёт её для всех
  несовпавших URL, если у проекта опубликован маршрут /404.
{%- endcomment -%}
{%- assign page_title = "Страница не найдена" -%}
{%- capture content -%}
<div class="status-screen">
  <span class="status-badge error" aria-hidden="true">404</span>
  <h1 class="status-title">Страница не найдена</h1>
  <p class="status-text">Такой страницы нет — возможно, товар распродан или ссылка устарела.</p>
  <div class="status-actions"><a class="btn btn-primary btn-lg" href="/">В каталог</a></div>
  <p class="status-help">Ошибка 404 — вы можете сообщить о битой ссылке в поддержку.</p>
</div>
{%- endcapture -%}
{% include "base" %}
