{%- comment -%}
  email-order-vendor.liquid — письмо продавцу о новом заказе (D22).
  ТЕЛО письма: config.template = этот файл, config.layout = email-layout.
  Адресат (to) задаётся нодой send_email в Сценариях — шаблон только рендерит.

  ⚠ Адресация — только результаты flow (M1): results.calc.*, results.order.*,
  results.g_site.* (словарь t_* через partials/ui-text, ветка results),
  json.customer.* / json.comment — тело POST чекаута.
{%- endcomment -%}
{%- include "partials/ui-text" -%}
{%- assign eorder_id = results.order.createOrder.id -%}
{%- assign eamount = results.calc.amount -%}
<h2>{{ t_email_vendor_heading }} <span class="email-mono">{{ eorder_id }}</span></h2>
<p class="email-meta">{{ t_order_no }} {{ eorder_id }} · {{ t_total_to_pay }}: {{ eamount }} ₽</p>

<h2>{{ t_email_items_title }}</h2>
<table class="email-items" cellpadding="0" cellspacing="0">
  {%- for l in results.calc.lines -%}
  {%- assign line_sum = l.price_kopecks | times: l.qty -%}
  <tr>
    <td>{{ l.title }} × {{ l.qty }}</td>
    <td class="num">{{ line_sum | times: 0.01 | money }} ₽</td>
  </tr>
  {%- endfor -%}
</table>

<h2>{{ t_email_customer_label }}</h2>
<p class="email-meta">
  {%- if json.customer.name %}{{ json.customer.name }}{% endif -%}
  {%- if json.customer.email %} · {{ json.customer.email }}{% endif -%}
  {%- if json.customer.phone %} · {{ t_email_phone_label }}: {{ json.customer.phone }}{% endif -%}
</p>
{%- if json.comment -%}
<p class="email-meta">{{ t_email_comment_label }}: {{ json.comment }}</p>
{%- endif -%}
