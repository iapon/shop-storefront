{%- comment -%}
  order-status.liquid — статус заказа (биндинг: o.data.order, 0..1).
  Один экран покрывает оба состояния: new → «Заказ принят» + подсказка про
  отмену; paid → «Заказ оплачен ✓»; нет заказа → «Заказ не найден».
  Номер заказа — единственный font-mono на странице. Персональные данные —
  noindex. Тексты — словарь (подстановки {{amount}}/{{email}} — replace).
{%- endcomment -%}
{%- include "partials/ui-text" -%}
{%- assign ord = o.data.order -%}
{%- if ord -%}
  {%- assign page_title = t_order_no | append: " " | append: ord.id -%}
  {%- assign page_canon = "__SHOP_BASE__/order/" | append: ord.id -%}
{%- else -%}
  {%- assign page_title = t_order_not_found -%}
{%- endif -%}
{%- assign page_noindex = true -%}
{%- capture content -%}
<div class="status-screen">
  {%- if ord -%}
    {%- if ord.status == "paid" -%}
      <span class="status-badge success" aria-hidden="true">✓</span>
      <h1 class="status-title">{{ t_order_paid }}</h1>
      {%- comment -%} email покупателя — его же ввод: escape вместе со словарной строкой {%- endcomment -%}
      {%- assign op_txt = t_order_paid_text | replace: "{{email}}", ord.customer_email -%}
      <p class="status-text">{{ op_txt | escape }}</p>
    {%- elsif ord.status == "cancelled" -%}
      <span class="status-badge error" aria-hidden="true">×</span>
      <h1 class="status-title">{{ t_order_cancelled }}</h1>
      <p class="status-text">{{ t_order_cancelled_text }}</p>
    {%- else -%}
      <span class="status-badge brand" aria-hidden="true">…</span>
      <h1 class="status-title">{{ t_order_new }}</h1>
      {%- assign on_txt = t_order_new_text | replace: "{{amount}}", ord.amount -%}
      <p class="status-text">{{ on_txt | escape }}</p>
      <p class="status-text">{{ t_order_new_cancel_hint }}</p>
    {%- endif -%}
    <p class="status-order-no">{{ t_order_no }} {{ ord.id }}</p>
    {%- if ord.items_summary -%}<p class="status-text text-3">{{ ord.items_summary }}</p>{%- endif -%}
    <p class="status-help">{{ t_order_save_link }}</p>
    <div class="status-actions"><a class="btn btn-secondary" href="__SHOP_BASE__/">{{ t_back_to_catalog }}</a></div>
  {%- else -%}
    <span class="status-badge error" aria-hidden="true">∅</span>
    <h1 class="status-title">{{ t_order_not_found }}</h1>
    <p class="status-text">{{ t_order_not_found_text }}</p>
    <div class="status-actions"><a class="btn btn-primary btn-lg" href="__SHOP_BASE__/">{{ t_to_catalog }}</a></div>
  {%- endif -%}
</div>
{%- endcapture -%}
{% include "base" %}
