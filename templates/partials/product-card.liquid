{%- comment -%}
  partials/product-card.liquid — карточка товара (используется каталогом,
  категорией и «Похожими»). ЧИСТАЯ ФУНКЦИЯ: ожидает товар в переменной p
  (переменные текут вниз — читает, не назначает). Бейдж наличия —
  partial stock-badge (тоже чистый: читает p.stock); волна B добавит сюда
  сердечко избранного.
{%- endcomment -%}
<a class="product-card" href="__SHOP_BASE__/product/{{ p.slug }}">
  <div class="product-card-photo">
    {%- if p.photos and p.photos.size > 0 -%}
      <img src="{{ p.photos[0].url }}" alt="{{ p.title }}" loading="lazy">
    {%- else -%}
      <span>{{ t_no_photo }}</span>
    {%- endif -%}
  </div>
  <div class="product-card-body">
    <h3 class="product-card-title">{{ p.title }}</h3>
    <div class="product-card-price">{{ p.price_kopecks | times: 0.01 | money }}<span class="rub">₽</span></div>
    {% include "partials/stock-badge" %}
  </div>
</a>
