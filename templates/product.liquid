          <fieldset class="variant-picker" data-variant-picker>
            <legend class="sr-only">Вариант</legend>
            <p class="pv-status" data-pv-status aria-live="polite">{%- if pv_def -%}{%- assign pv_status_vals = "" -%}{%- assign pv_sfirst = true -%}{%- for pv_d in pv_dim_arr -%}{%- unless pv_d == blank -%}{%- assign pv_defval = blank -%}{%- assign pv_opt_join = "" -%}{%- if pv_def.options -%}{%- assign pv_opt_json = pv_def.options | json -%}{%- if pv_opt_json contains '["' -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '["' | split: '"]' | first | split: '","' | join: ";" -%}{%- elsif pv_opt_json == "null" -%}{%- assign pv_opt_join = "" -%}{%- else -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '"' | split: '"' | first -%}{%- endif -%}{%- endif -%}{%- if pv_no_dims -%}{%- assign pv_opt_join = "Вариант:" | append: pv_def.label -%}{%- endif -%}{%- assign pv_pairs = pv_opt_join | split: ";" -%}{%- for pp in pv_pairs -%}{%- assign pp_t = pp | strip -%}{%- if pp_t != blank -%}{%- assign pv_ci = pp_t | split: ":" -%}{%- assign pv_dname = pv_ci[0] | strip -%}{%- assign pv_dval = pp_t | remove_first: pv_dname | remove_first: ":" | strip -%}{%- if pv_dname == pv_d and pv_dval != blank -%}{%- assign pv_defval = pv_dval -%}{%- endif -%}{%- endif -%}{%- endfor -%}{%- if pv_defval != blank -%}{% unless pv_sfirst %}{% assign pv_status_vals = pv_status_vals | append: " / " %}{% endunless %}{% assign pv_status_vals = pv_status_vals | append: pv_defval %}{% assign pv_sfirst = false %}{%- endif -%}{%- endunless -%}{%- endfor -%}<b>{{ pv_status_vals }}</b> — {{ pv_def.price_kopecks | times: 0.01 | money }} ₽ · в наличии {{ pv_def.stock }}{%- else -%}<span class="pv-status-off">нет в наличии</span>{%- endif -%}</p>
            {%- assign pv_color_names = "|синий|голубой|красный|розовый|зелёный|оливковый|чёрный|серый|белый|жёлтый|оранжевый|фиолетовый|сиреневый|коричневый|бежевый|бирюзовый|бордовый|мятный|" -%}
            {%- comment -%} фото варианта говорят о его ЦВЕТЕ — свотчи живут
               на ПЕРВОМ измерении, у значений которого они есть (у размера —
               пилюли/заливка, мокап A). {%- endcomment -%}
            {%- assign pv_photo_dims = "" -%}
            {%- for pv_d in pv_dim_arr -%}
              {%- unless pv_d == blank -%}
                {%- assign pv_d_hasphoto = false -%}
                {%- for v in pv_vars -%}
                  {%- if pv_d_hasphoto -%}{%- break -%}{%- endif -%}
                  {%- unless v.photos and v.photos.size > 0 -%}{%- continue -%}{%- endunless -%}
                  {%- assign pv_opt_join = "" -%}
                  {%- if v.options -%}{%- assign pv_opt_json = v.options | json -%}{%- if pv_opt_json contains '["' -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '["' | split: '"]' | first | split: '","' | join: ";" -%}{%- elsif pv_opt_json == "null" -%}{%- assign pv_opt_join = "" -%}{%- else -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '"' | split: '"' | first -%}{%- endif -%}{%- endif -%}
                  {%- if pv_no_dims -%}{%- assign pv_opt_join = "Вариант:" | append: v.label -%}{%- endif -%}
                  {%- assign pv_pairs = pv_opt_join | split: ";" -%}
                  {%- for pp in pv_pairs -%}
                    {%- assign pp_t = pp | strip -%}
                    {%- if pp_t != blank -%}
                      {%- assign pv_ci = pp_t | split: ":" -%}
                      {%- assign pv_dname = pv_ci[0] | strip -%}
                      {%- assign pv_dval = pp_t | remove_first: pv_dname | remove_first: ":" | strip -%}
                      {%- if pv_dname == pv_d and pv_dval != blank -%}{%- assign pv_d_hasphoto = true -%}{%- break -%}{%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
                {%- if pv_d_hasphoto -%}
                  {%- assign pv_probe = "|" | append: pv_d | append: "|" -%}
                  {%- unless pv_photo_dims contains pv_probe -%}{%- assign pv_photo_dims = pv_photo_dims | append: pv_probe -%}{%- endunless -%}
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
            {%- assign pv_photo_arr = pv_photo_dims | split: "|" -%}
            {%- assign pv_photo_first = "" -%}
            {%- for pv_x in pv_photo_arr -%}
              {%- if pv_x != blank and pv_photo_first == "" -%}{%- assign pv_photo_first = pv_x -%}{%- endif -%}
            {%- endfor -%}
            {%- for pv_d in pv_dim_arr -%}
            {%- unless pv_d == blank -%}
                        {%- assign pv_defval = blank -%}
            {%- if pv_def -%}
              {%- assign pv_opt_join = "" -%}
              {%- if pv_def.options -%}{%- assign pv_opt_json = pv_def.options | json -%}{%- if pv_opt_json contains '["' -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '["' | split: '"]' | first | split: '","' | join: ";" -%}{%- elsif pv_opt_json == "null" -%}{%- assign pv_opt_join = "" -%}{%- else -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '"' | split: '"' | first -%}{%- endif -%}{%- endif -%}
              {%- if pv_no_dims -%}{%- assign pv_opt_join = "Вариант:" | append: pv_def.label -%}{%- endif -%}
              {%- assign pv_pairs = pv_opt_join | split: ";" -%}
              {%- for pp in pv_pairs -%}
                {%- assign pp_t = pp | strip -%}
                {%- if pp_t != blank -%}
                  {%- assign pv_ci = pp_t | split: ":" -%}
                  {%- assign pv_dname = pv_ci[0] | strip -%}
                  {%- assign pv_dval = pp_t | remove_first: pv_dname | remove_first: ":" | strip -%}
                  {%- if pv_dname == pv_d and pv_dval != blank -%}{%- assign pv_defval = pv_dval -%}{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- assign pv_vals = "" -%}
            {%- assign pv_d_hasphoto = false -%}
            {%- for v in pv_vars -%}
              {%- assign pv_opt_join = "" -%}
              {%- if v.options -%}{%- assign pv_opt_json = v.options | json -%}{%- if pv_opt_json contains '["' -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '["' | split: '"]' | first | split: '","' | join: ";" -%}{%- elsif pv_opt_json == "null" -%}{%- assign pv_opt_join = "" -%}{%- else -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '"' | split: '"' | first -%}{%- endif -%}{%- endif -%}
              {%- if pv_no_dims -%}{%- assign pv_opt_join = "Вариант:" | append: v.label -%}{%- endif -%}
              {%- assign pv_pairs = pv_opt_join | split: ";" -%}
              {%- for pp in pv_pairs -%}
                {%- assign pp_t = pp | strip -%}
                {%- if pp_t != blank -%}
                  {%- assign pv_ci = pp_t | split: ":" -%}
                  {%- assign pv_dname = pv_ci[0] | strip -%}
                  {%- assign pv_dval = pp_t | remove_first: pv_dname | remove_first: ":" | strip -%}
                  {%- if pv_dname == pv_d and pv_dval != blank -%}
                    {%- assign pv_vprobe = "|" | append: pv_dval | append: "|" -%}
                    {%- unless pv_vals contains pv_vprobe -%}{%- assign pv_vals = pv_vals | append: pv_vprobe -%}{%- endunless -%}
                    {%- if v.photos and v.photos.size > 0 -%}{%- assign pv_d_hasphoto = true -%}{%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- assign pv_val_arr = pv_vals | split: "|" -%}
            {%- comment -%} режим значений: фото-свотчи, если у значений есть
               фото; иначе цветная заливка, если ВСЕ значения в карте цветов;
               иначе текстовые пилюли. {%- endcomment -%}
            {%- assign pv_fillmiss = 0 -%}
            {%- for pv_v in pv_val_arr -%}
              {%- unless pv_v == blank -%}
                {%- assign pv_vdown = pv_v | downcase | strip -%}
                {%- assign pv_cprobe = "|" | append: pv_vdown | append: "|" -%}
                {%- unless pv_color_names contains pv_cprobe -%}{%- assign pv_fillmiss = pv_fillmiss | plus: 1 -%}{%- endunless -%}
              {%- endunless -%}
            {%- endfor -%}
            {%- assign pv_mode = "pill" -%}
            {%- if pv_d_hasphoto and pv_d == pv_photo_first -%}{%- assign pv_mode = "swatch" -%}{%- elsif pv_fillmiss == 0 -%}{%- assign pv_mode = "fill" -%}{%- endif -%}
            <div class="pv-dim">
              <span class="pv-dim-label" id="pv-dim-{{ forloop.index0 }}-label">{{ pv_d }}: <span class="pv-dim-val" data-pv-dim-val="{{ pv_d | escape }}">{% if pv_defval != blank %}{{ pv_defval }}{% else %}—{% endif %}</span></span>
              <div class="pv-values" role="radiogroup" aria-labelledby="pv-dim-{{ forloop.index0 }}-label" data-pv-group="{{ pv_d | escape }}" data-pv-mode="{{ pv_mode }}">
              {%- for pv_v in pv_val_arr -%}
              {%- unless pv_v == blank -%}
                {%- assign pv_vphoto = "" -%}
                {%- assign pv_vok = false -%}
                {%- for v in pv_vars -%}
                  {%- assign pv_opt_join = "" -%}
                  {%- if v.options -%}{%- assign pv_opt_json = v.options | json -%}{%- if pv_opt_json contains '["' -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '["' | split: '"]' | first | split: '","' | join: ";" -%}{%- elsif pv_opt_json == "null" -%}{%- assign pv_opt_join = "" -%}{%- else -%}{%- assign pv_opt_join = pv_opt_json | remove_first: '"' | split: '"' | first -%}{%- endif -%}{%- endif -%}
                  {%- if pv_no_dims -%}{%- assign pv_opt_join = "Вариант:" | append: v.label -%}{%- endif -%}
                  {%- assign pv_pairs = pv_opt_join | split: ";" -%}
                  {%- for pp in pv_pairs -%}
                    {%- assign pp_t = pp | strip -%}
                    {%- if pp_t != blank -%}
                      {%- assign pv_ci = pp_t | split: ":" -%}
                      {%- assign pv_dname = pv_ci[0] | strip -%}
                      {%- assign pv_dval = pp_t | remove_first: pv_dname | remove_first: ":" | strip -%}
                      {%- if pv_dname == pv_d and pv_dval == pv_v -%}
                        {%- if v.stock > 0 -%}{%- assign pv_vok = true -%}{%- endif -%}
                        {%- if pv_vphoto == blank and v.photos and v.photos.size > 0 -%}
                          {%- assign pv_vp = v.photos | first -%}
                          {%- assign pv_vphoto = pv_vp.url -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
                {%- assign pv_on = false -%}
                {%- if pv_def and pv_defval == pv_v -%}{%- assign pv_on = true -%}{%- endif -%}
                {%- assign pv_vdown = pv_v | downcase | strip -%}
                {%- assign pv_vhex = "#9aa3af" -%}
                {%- case pv_vdown -%}
                  {%- when "синий" -%}{%- assign pv_vhex = "#2f6fed" -%}
                  {%- when "голубой" -%}{%- assign pv_vhex = "#38bdf8" -%}
                  {%- when "красный" -%}{%- assign pv_vhex = "#d64545" -%}
                  {%- when "розовый" -%}{%- assign pv_vhex = "#ec4899" -%}
                  {%- when "зелёный" -%}{%- assign pv_vhex = "#2f8f5b" -%}
                  {%- when "оливковый" -%}{%- assign pv_vhex = "#6b8e23" -%}
                  {%- when "чёрный" -%}{%- assign pv_vhex = "#1f2328" -%}
                  {%- when "серый" -%}{%- assign pv_vhex = "#9aa3af" -%}
                  {%- when "белый" -%}{%- assign pv_vhex = "#f2f3f5" -%}
                  {%- when "жёлтый" -%}{%- assign pv_vhex = "#f5c518" -%}
                  {%- when "оранжевый" -%}{%- assign pv_vhex = "#f97316" -%}
                  {%- when "фиолетовый" -%}{%- assign pv_vhex = "#8b5cf6" -%}
                  {%- when "сиреневый" -%}{%- assign pv_vhex = "#c084fc" -%}
                  {%- when "коричневый" -%}{%- assign pv_vhex = "#8b5a2b" -%}
                  {%- when "бежевый" -%}{%- assign pv_vhex = "#d9c8a9" -%}
                  {%- when "бирюзовый" -%}{%- assign pv_vhex = "#14b8a6" -%}
                  {%- when "бордовый" -%}{%- assign pv_vhex = "#7f1d1d" -%}
                  {%- when "мятный" -%}{%- assign pv_vhex = "#6ee7b7" -%}
                {%- endcase -%}
                <button type="button" role="radio" class="pv-btn" data-pv-dim="{{ pv_d | escape }}" data-pv-value="{{ pv_v | escape }}"
                        aria-checked="{% if pv_on %}true{% else %}false{% endif %}" tabindex="{% if pv_on %}0{% else %}-1{% endif %}"
                        {%- unless pv_vok %} aria-disabled="true"{% endunless %}
                        aria-label="{{ pv_v | escape }}{%- unless pv_vok %}, нет в наличии{% endunless -%}">
                {%- if pv_mode == "swatch" -%}
                  {%- if pv_vphoto != blank -%}
                  <img src="{{ pv_vphoto }}" alt="" loading="lazy" decoding="async" width="48" height="48">
                  {%- else -%}
                  <span class="pv-fill" style="background:{{ pv_vhex }}"></span>
                  {%- endif -%}
                {%- elsif pv_mode == "fill" -%}
                  <span class="pv-fill" style="background:{{ pv_vhex }}"></span>
                {%- else -%}
                  {{ pv_v }}
                {%- endif -%}
                </button>
              {%- endunless -%}
              {%- endfor -%}
              </div>
            </div>
            {%- endunless -%}
            {%- endfor -%}
          </fieldset>
          <script type="application/json" data-pv-data>{"default":{% if pv_def %}{{ pv_def.id | json }}{% else %}null{% endif %},"dims":[{{ pv_dims_json }}],"variants":[{{ pv_variants_json }}]}</script>
          {%- if pv_def -%}
          <div class="qty-stepper" data-cart-stepper>
            <button class="qty-btn" type="button" data-qty-step="-1" aria-label="Уменьшить количество">−</button>
            <input class="qty-input" type="number" min="1" value="1" inputmode="numeric"
                   aria-label="Количество" data-cart-qty>
            <button class="qty-btn" type="button" data-qty-step="1" aria-label="Увеличить количество">+</button>
          </div>
          {%- comment -%} W9 (F6a): data-stock — карман остатка для cart.js:
            попытка добавить больше гасится до остатка С сообщением
            (регион data-cart-note под строкой покупки), не молча.
            B2a: data-variant — текущий вариант (обновляет пикер), cart.js
            кладёт строку-пару (slug+variant, D23). {%- endcomment -%}
          <button class="btn btn-primary" type="button" data-cart-add="{{ product.slug }}" data-variant="{{ pv_def.id }}" data-stock="{{ pv_def.stock }}">{{ cfg.cta_add_to_cart | default: "В корзину" | escape }}</button>
          {%- endif -%}
        {%- elsif product.stock > 0 -%}
          {%- assign p = product -%}
          {% include "partials/stock-badge" %}
          <div class="qty-stepper" data-cart-stepper>
            <button class="qty-btn" type="button" data-qty-step="-1" aria-label="Уменьшить количество">−</button>
            <input class="qty-input" type="number" min="1" value="1" inputmode="numeric"
                   aria-label="Количество" data-cart-qty>
            <button class="qty-btn" type="button" data-qty-step="1" aria-label="Увеличить количество">+</button>
          </div>
          {%- comment -%} W9 (F6a): data-stock — карман остатка для cart.js:
            попытка добавить больше гасится до остатка С сообщением
            (регион data-cart-note под строкой покупки), не молча. {%- endcomment -%}
          <button class="btn btn-primary" type="button" data-cart-add="{{ product.slug }}" data-stock="{{ product.stock }}">{{ cfg.cta_add_to_cart | default: "В корзину" | escape }}</button>
        {%- else -%}
          {%- assign p = product -%}
          {% include "partials/stock-badge" %}
        {%- endif -%}
      </div>
      <p class="cart-note" data-cart-note role="status" aria-live="polite"></p>
      {%- if product.description -%}
      <div class="product-desc">{{ product.description }}</div>
      {%- endif -%}
      {%- if product.features and product.features.size > 0 -%}
      <h2 class="features-heading">Характеристики</h2>
      <ul class="feature-list">
        {%- for f in product.features -%}<li class="feature-item">{{ f }}</li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
    </div>

    {%- comment -%} B2c: отзывы — только published (модерация статусом в
       админке: форма пишет status=new, владелец переводит в published —
       написанный отзыв появляется на странице после проверки). Форма —
       НАТИВНЫЙ POST (no-JS контракт; редирект 303 делает флоу
       shop_review): honeypot «сайт» — как на чекауте, ?review=ok —
       подтверждение. Поля отзыва эскейпятся — B-1 (данные анонима).
       v1.7.1: сама форма — только вошедшему (гейт ниже), плюс серверный
       гард во флоу shop_review (cookies.member — код auth_required).
       v1.7.3 — дизайн A «Ряд» (мокапы picker-design/review-A-*): шапка
       одной строкой — заголовок + средняя крупно + ЧЕСТНЫЕ SVG-звёзды
       (4.5 = 4 полных + половина: трек + заливка-обрезка по ширине,
       инлайн-спрайт #shop-star, aria-hidden — оценка дублирует текст)
       + счётчик (русские формы), справа «Написать отзыв» (member — якорь
       формы, гость — логин с next-возвратом). Карточки: инициал-аватар
       (accent-tint), имя, «Проверенная покупка» (БУДУЩЕЕ поле member-связи —
       в схеме review его нет, сегодня бейджа нет и блок не ломается), дата
       справа, мелкие звёзды оценки, текст. Цвет звёзд — токен --warn
       (рейтинг-семантика, не бренд); в тёмной теме автосветление токеном. {%- endcomment -%}
    <section class="reviews" aria-labelledby="reviews-title">
      <svg class="review-sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><symbol id="shop-star" viewBox="0 0 24 24"><path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></symbol></svg>
      <div class="reviews-head">
        <h2 class="reviews-title" id="reviews-title">Отзывы</h2>
        {%- if revs_count > 0 -%}
        {%- assign pv_n10 = revs_count | modulo: 10 -%}{%- assign pv_n100 = revs_count | modulo: 100 -%}
        {%- assign revs_word = "отзывов" -%}
        {%- unless pv_n100 >= 12 and pv_n100 <= 14 -%}
          {%- if pv_n10 == 1 -%}{%- assign revs_word = "отзыв" -%}{%- elsif pv_n10 == 2 or pv_n10 == 3 or pv_n10 == 4 -%}{%- assign revs_word = "отзыва" -%}{%- endif -%}
        {%- endunless -%}
        <span class="reviews-avg">{{ revs_avg | replace: ".", "," }}</span>
        <span class="stars stars-lg" role="img" aria-label="Средняя оценка {{ revs_avg | replace: ".", "," }} из 5">{%- for i in (1..5) -%}<span class="star"><svg class="star-track" aria-hidden="true" focusable="false"><use href="#shop-star"/></svg><span class="star-fill" style="width:{% if i == 1 %}{{ revs_star1 }}{% elsif i == 2 %}{{ revs_star2 }}{% elsif i == 3 %}{{ revs_star3 }}{% elsif i == 4 %}{{ revs_star4 }}{% else %}{{ revs_star5 }}{% endif %}%" aria-hidden="true"><svg focusable="false"><use href="#shop-star"/></svg></span></span>{%- endfor -%}</span>
        <span class="reviews-count">{{ revs_count }} {{ revs_word }}</span>
        {%- endif -%}
        {%- if member and member.id -%}
        <a class="reviews-cta" href="#review-form">Написать отзыв</a>
        {%- else -%}
        <a class="reviews-cta" href="/login?next=__SHOP_BASE__/product/{{ product.slug | escape }}">Написать отзыв</a>
        {%- endif -%}
      </div>
      {%- if revs_count == 0 -%}
      <p class="reviews-meta">Пока нет отзывов — станьте первым.</p>
      {%- endif -%}
      {%- if revs_count > 0 -%}
      <ul class="review-list">
        {%- for r in revs_list -%}
        <li class="review-card">
          <span class="review-avatar" aria-hidden="true">{{ r.author_name | strip | slice: 0, 1 | upcase }}</span>
          <div class="review-main">
            <div class="review-head">
              <span class="review-author">{{ r.author_name | escape }}</span>
              {%- comment -%} «Проверенная покупка» — будущее поле member-связи
                 (picker-design §3): в схеме review его нет — бейдж не
                 рендерится и блок не ломается (опция карточки). {%- endcomment -%}
              {%- if r.verified -%}<span class="review-verified"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M2 6.5L4.5 9 10 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Проверенная покупка</span>{%- endif -%}
              <span class="review-date">{{ r.created_at | date_ru: "%-d %B %Y" }}</span>
            </div>
            <div class="review-stars-row"><span class="stars stars-sm" role="img" aria-label="Оценка {{ r.rating }} из 5">{%- for i in (1..5) -%}<span class="star"><svg class="star-track" aria-hidden="true" focusable="false"><use href="#shop-star"/></svg><span class="star-fill" style="width:{% if i <= r.rating %}100{% else %}0{% endif %}%" aria-hidden="true"><svg focusable="false"><use href="#shop-star"/></svg></span></span>{%- endfor -%}</span></div>
            {%- if r.body -%}<p class="review-body">{{ r.body | escape }}</p>{%- endif -%}
          </div>
        </li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
      {%- if query.review == "ok" -%}
      <p class="form-ok" role="status">Спасибо! Отзыв отправлен — он появится на странице после проверки.</p>
      {%- endif -%}
      {%- comment -%} Отзывы-вход (v1.7.1): форма — только вошедшему
         (member — первая-класс переменная сессии, прецедент login.liquid;
         страница анонима кэшируется TTL 300 — гейт обязан быть SSR-ным,
         член-запросы рендерятся всегда живьём). Анониму — тихий CTA
         с возвратом на товар (?next=…, локальный путь; гард open-redirect
         и переход — в js/auth.js, no-JS фоллбек — дефолт-редирект сервера).
         Список отзывов/средняя/?review=ok — видны всем. {%- endcomment -%}
      {%- if member and member.id -%}
      <form class="review-form" id="review-form" method="post" action="__SHOP_BASE__/review">
        <h3 class="review-form-title">Оставить отзыв</h3>
        {%- comment -%} honeypot: поле «сайт» скрыто от человека; боты заполняют.
           Сервер молча отдаёт 303 без записи (паттерн чекаута). {%- endcomment -%}
        <div class="hp-field" aria-hidden="true">
          <label>Сайт <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        </div>
        <input type="hidden" name="slug" value="{{ product.slug | escape }}">
        <label class="review-label" for="review-name">Имя</label>
        <input class="field-input" id="review-name" name="author_name" type="text" required maxlength="100" placeholder="Как вас зовут">
        <label class="review-label" for="review-rating">Оценка</label>
        <select class="field-input" id="review-rating" name="rating">
          <option value="5">5 — отлично</option>
          <option value="4">4 — хорошо</option>
          <option value="3">3 — нормально</option>
          <option value="2">2 — так себе</option>
          <option value="1">1 — плохо</option>
        </select>
        <label class="review-label" for="review-body">Отзыв</label>
        <textarea class="field-input" id="review-body" name="body" rows="4" placeholder="Поделитесь впечатлениями"></textarea>
        <button class="btn btn-primary" type="submit">Отправить отзыв</button>
      </form>
      {%- else -%}
      <p class="review-login">
        <a href="/login?next=__SHOP_BASE__/product/{{ product.slug | escape }}">Войдите</a>, чтобы оставить отзыв, или
        <a href="/register?next=__SHOP_BASE__/product/{{ product.slug | escape }}">зарегистрируйтесь</a>.
      </p>
      {%- endif -%}
    </section>
  </div>

  <script>
  /* Галерея v3 (B1-v2 + v1.7.2): нативная scroll-snap карусель — свайп на
     таче бесплатный (композитор, ноль JS в кадре), миниатюры/стрелки скроллят
     track smooth scrollTo, позицию показывает is-active миниатюр.
     Скролл-событие гейтится rAF (один sync на кадр); prefers-reduced-
     motion — все прокрутки 'auto' (мгновенные). A11y: track/slide несут
     role=group + aria-roledescription (APG carousel), смена кадра
     объявляется sr-only status-строкой. Первый кадр eager +
     fetchpriority="high" (шаблон), остальные lazy — не противоречит
     джанк-фиксу карточек. Без JS: track остаётся горизонтальным
     скроллером (свайп работает и без скрипта), миниатюры — обычные
     кнопки без синхронизации.
     v1.7.2 (вариантные фото): слушатель gallery:replace — пикер меняет
     вариант, трек кроссфейдит подмену слайдов (data-swap → opacity 0,
     замена, проявление; reduce — мгновенно); миниатюры перестраиваются
     (клики — делегированием, переживают перестройку), прячутся при ≤1
     кадре — как SSR-каркас. Миниатюр нет при SSR (1 кадр) — replace
     всё равно работает (полоса спрятана атрибутом hidden). */
  (function () {
    var track = document.querySelector('[data-gallery-track]');
    if (!track) return;
    var strip = document.querySelector('[data-gallery-thumbs]');
    var status = document.querySelector('[data-gallery-status]');
    var navs = document.querySelectorAll('[data-gallery-step]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function behavior() { return reduce ? 'auto' : 'smooth'; }
    function thumbs() { return strip ? strip.querySelectorAll('[data-gallery-thumb]') : []; }
    function count() { return track.querySelectorAll('.gallery-slide').length; }
    function active() {
      var w = track.clientWidth;
      if (!w) return 0;
      return Math.min(count() - 1, Math.max(0, Math.round(track.scrollLeft / w)));
    }
    var last = -1;
    function sync() {
      var th = thumbs();
      var n = th.length;
      if (!n) return;
      var i = active();
      if (i === last) return;
      last = i;
      for (var j = 0; j < n; j++) {
        th[j].classList.toggle('is-active', j === i);
        th[j].setAttribute('aria-pressed', j === i ? 'true' : 'false');
      }
      if (status) status.textContent = 'Фото ' + (i + 1) + ' из ' + n;
      var act = th[i];
      if (act && act.scrollIntoView) act.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: behavior() });
    }
    function go(idx) {
      var n = count();
      if (!n) return;
      idx = (idx + n) % n;
      track.scrollTo({ left: idx * track.clientWidth, behavior: behavior() });
    }
    var raf = 0;
    track.addEventListener('scroll', function () {
      if (raf) return;
      raf = window.requestAnimationFrame(function () { raf = 0; sync(); });
    }, { passive: true });
    if (strip) strip.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest ? e.target.closest('[data-gallery-thumb]') : null;
      if (!btn) return;
      var th = thumbs();
      for (var i = 0; i < th.length; i++) if (th[i] === btn) { go(i); return; }
    });
    if (strip) strip.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      var dir = e.key === 'ArrowRight' ? 1 : -1;
      var th = thumbs();
      var i = (active() + dir + th.length) % th.length;
      go(i);
      if (th[i]) th[i].focus();
    });
    navs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        go(active() + Number(btn.getAttribute('data-gallery-step')));
      });
    });
    function makeSlide(url, i, n) {
      var slide = document.createElement('div');
      slide.className = 'gallery-slide';
      slide.setAttribute('role', 'group');
      slide.setAttribute('aria-roledescription', 'слайд');
      slide.setAttribute('aria-label', 'Фото ' + (i + 1) + ' из ' + n);
      var img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.decoding = 'async';
      img.width = 800;
      img.height = 1000;
      if (i === 0) img.setAttribute('fetchpriority', 'high'); else img.loading = 'lazy';
      slide.appendChild(img);
      return slide;
    }
    function makeThumb(url, i, n) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'gallery-thumb' + (i === 0 ? ' is-active' : '');
      b.setAttribute('data-gallery-thumb', url);
      b.setAttribute('aria-label', 'Фото ' + (i + 1) + ' из ' + n);
      b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
      var img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.width = 96;
      img.height = 120;
      b.appendChild(img);
      return b;
    }
    function replace(urls) {
      var n = urls.length;
      if (!n) return;
      var doSwap = function () {
        track.innerHTML = '';
        for (var i = 0; i < n; i++) track.appendChild(makeSlide(urls[i], i, n));
        track.scrollLeft = 0;
        last = -1;
        var many = n > 1;
        if (strip) {
          strip.innerHTML = '';
          for (var k = 0; k < n; k++) strip.appendChild(makeThumb(urls[k], k, n));
          strip.hidden = !many;
        }
        navs.forEach(function (btn) { btn.hidden = !many; });
        if (status) status.textContent = many ? 'Фото 1 из ' + n : '';
        sync();
      };
      if (reduce) { doSwap(); return; }
      track.setAttribute('data-swap', '1');
      window.setTimeout(function () { doSwap(); track.removeAttribute('data-swap'); }, 170);
    }
    document.addEventListener('gallery:replace', function (e) {
      var urls = e && e.detail && e.detail.urls;
      if (urls && urls.length) replace(urls);
    });
    sync();
  })();
  </script>

  {%- if pv_has -%}
  {%- comment -%} v1.7.3: логика пикера вынесена в static/js/picker.js —
     группировка вариантов по options-парам, выбор по измерениям → резолв в
     вариант id, WB-механика недоступной комбинации (авто-перескок, клик по
     приглушённому не выбирает), строка статуса aria-live. Делегирование на
     document — переживает fetch-свапы (совместимость с catalog.js/favorites.js),
     ре-инициализация не нужна. Данные — data-pv-data выше. Контракт корзины
     B2a (D23) НЕ тронут: кнопка несёт data-variant/data-stock выбранного
     варианта (обновляет picker.js), cart.js кладёт строку-пару. Без JS скрипт
     не работает — SSR-дефолт честен (см. data-pv-data). {%- endcomment -%}
  <script src="/static/js/picker.js?v={{ site.version }}" defer></script>
  {%- endif -%}

    {%- if rel.data.products.size > 0 -%}
    {%- assign card_lazy_all = true -%}{%- comment -%} B1-v2: «Похожие» ниже фолда — карточки всегда lazy {%- endcomment -%}
    <h2 class="rel-heading">Похожие товары</h2>
    <div class="rel-grid">
      {% for p in rel.data.products %}{% include "partials/product-card" %}{% endfor %}
    </div>
    {%- assign card_lazy_all = nil -%}
    {%- endif -%}

  {%- else -%}
  <div class="status-screen" role="status" style="padding-left:0;padding-right:0;">
    <span class="status-badge error" aria-hidden="true">∅</span>
    <h1 class="status-title">Товар не найден</h1>
    <p class="status-text">Возможно, он распродан или снят с продажи.</p>
    <div class="status-actions"><a class="btn btn-primary btn-lg" href="__SHOP_BASE__/">В каталог</a></div>
  </div>
  {%- endif -%}
</div>
{%- endcapture -%}
