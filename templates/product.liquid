                {% unless gallery.size > 1 %}hidden{% endunless %}>›</button>
        {%- endif -%}
        {%- comment -%} B2c (F1): сердечко карточки товара — SSR-нейтральное
           (факт докатывает js/favorites.js одним GET; каталог кэшируется
