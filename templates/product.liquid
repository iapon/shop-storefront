           Left/Right шагают по фото (скрипт галереи ниже). {%- endcomment -%}
        {%- for ph in product.photos -%}
        <button class="gallery-thumb{% if forloop.first %} is-active{% endif %}" type="button"
                data-gallery-thumb="{{ ph.url }}" aria-label="{{ product.title | escape }} — фото {{ forloop.index }} из {{ product.photos.size }}"
                {% if forloop.first %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}>
          <img src="{{ ph.url }}" alt="" loading="lazy" decoding="async" width="96" height="120">
        </button>
        {%- endfor -%}
      </div>
      <p class="sr-only" data-gallery-status role="status" aria-live="polite"></p>
      {%- endif -%}
    </div>
    <div class="product-info">
      <h1 class="product-title">{{ product.title }}</h1>
      {%- comment -%} B2a: цена карточки = дефолтный вариант (первый со
         stock > 0), у безвариантного товара — базовая; span[data-pv-price]
         обновляет пикер. {%- endcomment -%}
      {%- if pv_has and pv_def -%}
        {%- assign pv_shown_price = pv_def.price_kopecks -%}
      {%- else -%}
        {%- assign pv_shown_price = product.price_kopecks -%}
      {%- endif -%}
      <div class="product-price"><span data-pv-price>{{ pv_shown_price | times: 0.01 | money }}</span><span class="rub">₽</span></div>
      <div class="buy-row">
        {%- if pv_has -%}
          {%- comment -%} B2a: вариантный товар — бейдж БИНАРНЫЙ по вариантам
             (badge_has_variants/badge_stock — вход partial stock-badge),
             product.stock игнорируется. Все нули → pv_def нет: пикер
             disabled, бейдж «Нет в наличии», кнопки/степпера нет. {%- endcomment -%}
          {%- assign badge_has_variants = true -%}
          {%- assign badge_stock = pv_in_stock -%}
          {%- assign badge_attrs = ' data-pv-badge' -%}
          {%- assign p = product -%}
          {% include "partials/stock-badge" %}
          {%- assign badge_has_variants = nil -%}
          {%- assign badge_stock = nil -%}
          {%- assign badge_attrs = nil -%}
          {%- comment -%} пикер рендерится для ЛЮБОГО вариантного товара:
             все нули → строки disabled (видно, что за варианты были),
             бейдж «Нет в наличии», кнопки/степпера/скрипта нет. {%- endcomment -%}
          <fieldset class="variant-picker" data-variant-picker>
            <legend class="sr-only">Вариант</legend>
            {%- for v in pv_vars -%}
            <label class="variant-row{% if v.stock <= 0 %} variant-row-off{% endif %}">
              <input type="radio" name="variant" value="{{ v.id }}"
                     data-variant-id="{{ v.id }}" data-price="{{ v.price_kopecks }}" data-stock="{{ v.stock }}"
                     {% if v.stock <= 0 %}disabled{% endif %}
                     {% if pv_def and pv_def.id == v.id %}checked{% endif %}>
              <span class="variant-name">{{ v.label }}</span>
              {%- if v.stock <= 0 -%}<span class="badge badge-error">Нет в наличии</span>{%- endif -%}
              <span class="variant-price">{{ v.price_kopecks | times: 0.01 | money }} ₽</span>
            </label>
            {%- endfor -%}
          </fieldset>
          {%- if pv_def -%}
          <div class="qty-stepper" data-cart-stepper>
            <button class="qty-btn" type="button" data-qty-step="-1" aria-label="Уменьшить количество">−</button>
            <input class="qty-input" type="number" min="1" value="1" inputmode="numeric"
                   aria-label="Количество" data-cart-qty>
            <button class="qty-btn" type="button" data-qty-step="1" aria-label="Увеличить количество">+</button>
          </div>
          {%- comment -%} W9 (F6a): data-stock — карман остатка для cart.js:
            попытка добавить больше гасится до остатка С сообщением
            (регион data-cart-note под строкой покупки), не молча.
            B2a: data-variant — текущий вариант (обновляет пикер), cart.js
            кладёт строку-пару (slug+variant, D23). {%- endcomment -%}
          <button class="btn btn-primary" type="button" data-cart-add="{{ product.slug }}" data-variant="{{ pv_def.id }}" data-stock="{{ pv_def.stock }}">{{ cfg.cta_add_to_cart | default: "В корзину" | escape }}</button>
          {%- endif -%}
        {%- elsif product.stock > 0 -%}
          {%- assign p = product -%}
          {% include "partials/stock-badge" %}
          <div class="qty-stepper" data-cart-stepper>
            <button class="qty-btn" type="button" data-qty-step="-1" aria-label="Уменьшить количество">−</button>
            <input class="qty-input" type="number" min="1" value="1" inputmode="numeric"
                   aria-label="Количество" data-cart-qty>
            <button class="qty-btn" type="button" data-qty-step="1" aria-label="Увеличить количество">+</button>
          </div>
          {%- comment -%} W9 (F6a): data-stock — карман остатка для cart.js:
            попытка добавить больше гасится до остатка С сообщением
            (регион data-cart-note под строкой покупки), не молча. {%- endcomment -%}
          <button class="btn btn-primary" type="button" data-cart-add="{{ product.slug }}" data-stock="{{ product.stock }}">{{ cfg.cta_add_to_cart | default: "В корзину" | escape }}</button>
        {%- else -%}
          {%- assign p = product -%}
          {% include "partials/stock-badge" %}
        {%- endif -%}
      </div>
      <p class="cart-note" data-cart-note role="status" aria-live="polite"></p>
      {%- if product.description -%}
      <div class="product-desc">{{ product.description }}</div>
      {%- endif -%}
      {%- if product.features and product.features.size > 0 -%}
      <h2 class="features-heading">Характеристики</h2>
      <ul class="feature-list">
        {%- for f in product.features -%}<li class="feature-item">{{ f }}</li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
    </div>
  </div>

  <script>
  /* Галерея v2 (B1-v2): нативная scroll-snap карусель — свайп на таче
     бесплатный (композитор, ноль JS в кадре), миниатюры/стрелки скроллят
     track smooth scrollTo, позицию показывает is-active миниатюры.
     Скролл-событие гейтится rAF (один sync на кадр); prefers-reduced-
     motion — все прокрутки 'auto' (мгновенные). A11y: track/slide несут
     role=group + aria-roledescription (APG carousel), смена кадра
     объявляется sr-only status-строкой. Первый кадр eager +
     fetchpriority="high" (шаблон), остальные lazy — не противоречит
     джанк-фиксу карточек. Без JS: track остаётся горизонтальным
     скроллером (свайп работает и без скрипта), миниатюры — обычные
     кнопки без синхронизации. */
  (function () {
    var track = document.querySelector('[data-gallery-track]');
    var thumbs = document.querySelectorAll('[data-gallery-thumb]');
    if (!track || !thumbs.length) return;
    var n = thumbs.length;
    var status = document.querySelector('[data-gallery-status]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function behavior() { return reduce ? 'auto' : 'smooth'; }
    function active() {
      var w = track.clientWidth;
      if (!w) return 0;
      return Math.min(n - 1, Math.max(0, Math.round(track.scrollLeft / w)));
    }
    var last = -1;
    function sync() {
      var i = active();
      if (i === last) return;
      last = i;
      for (var j = 0; j < n; j++) {
        thumbs[j].classList.toggle('is-active', j === i);
        thumbs[j].setAttribute('aria-pressed', j === i ? 'true' : 'false');
      }
      if (status) status.textContent = 'Фото ' + (i + 1) + ' из ' + n;
      var act = thumbs[i];
      if (act && act.scrollIntoView) act.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: behavior() });
    }
    function go(idx) {
      idx = (idx + n) % n;
      track.scrollTo({ left: idx * track.clientWidth, behavior: behavior() });
    }
    var raf = 0;
    track.addEventListener('scroll', function () {
      if (raf) return;
      raf = window.requestAnimationFrame(function () { raf = 0; sync(); });
    }, { passive: true });
    for (var k = 0; k < n; k++) {
      (function (idx) {
        thumbs[idx].addEventListener('click', function () { go(idx); });
      })(k);
    }
    document.querySelectorAll('[data-gallery-step]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        go(active() + Number(btn.getAttribute('data-gallery-step')));
      });
    });
    var strip = document.querySelector('[data-gallery-thumbs]');
    if (strip) strip.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      var dir = e.key === 'ArrowRight' ? 1 : -1;
      var i = (active() + dir + n) % n;
      go(i);
      thumbs[i].focus();
    });
    sync();
  })();
  </script>

  {%- if pv_def -%}
  <script>
  /* b2a-picker-start */
  /* B2a: пикер вариантов — change обновляет цену, бейдж наличия и карман
     остатка кнопки покупки (data-variant/data-stock, контракт cart.js).
     Бейдж бинарный по варианту (как SSR: > 0 = «В наличии», 0 = «Нет»).
     Страница товара — нативный переход (вне data-shop-main-свапа):
     элементные слушатели, ре-инициализация не нужна. Без JS пикер —
     обычные radio, чекнут по умолчанию SSR-дефолт, кнопка несёт его же. */
  (function () {
    var picker = document.querySelector('[data-variant-picker]');
    if (!picker) return;
    var radios = picker.querySelectorAll('input[data-variant-id]');
    var priceEl = document.querySelector('[data-pv-price]');
    var badgeEl = document.querySelector('[data-pv-badge]');
    var addBtn = document.querySelector('[data-cart-add]');
    function apply(v) {
      var price = Number(v.getAttribute('data-price'));
      var stock = Number(v.getAttribute('data-stock')) || 0;
      if (priceEl && isFinite(price)) priceEl.textContent = (price / 100).toFixed(2);
      if (badgeEl) {
        badgeEl.className = stock > 0 ? 'badge badge-success' : 'badge badge-error';
        badgeEl.textContent = stock > 0 ? 'В наличии' : 'Нет в наличии';
      }
      if (addBtn) {
        addBtn.setAttribute('data-variant', v.getAttribute('data-variant-id') || '');
        addBtn.setAttribute('data-stock', String(stock));
        addBtn.disabled = stock <= 0;
      }
    }
    for (var i = 0; i < radios.length; i++) {
      radios[i].addEventListener('change', function (ev) { apply(ev.target); });
    }
  })();
  /* b2a-picker-end */
  </script>
  {%- endif -%}

    {%- if rel.data.products.size > 0 -%}
    {%- assign card_lazy_all = true -%}{%- comment -%} B1-v2: «Похожие» ниже фолда — карточки всегда lazy {%- endcomment -%}
    <h2 class="rel-heading">Похожие товары</h2>
    <div class="rel-grid">
      {% for p in rel.data.products %}{% include "partials/product-card" %}{% endfor %}
    </div>
    {%- assign card_lazy_all = nil -%}
    {%- endif -%}

  {%- else -%}
  <div class="status-screen" role="status" style="padding-left:0;padding-right:0;">
    <span class="status-badge error" aria-hidden="true">∅</span>
    <h1 class="status-title">Товар не найден</h1>
    <p class="status-text">Возможно, он распродан или снят с продажи.</p>
    <div class="status-actions"><a class="btn btn-primary btn-lg" href="__SHOP_BASE__/">В каталог</a></div>
  </div>
  {%- endif -%}
</div>
{%- endcapture -%}
{% include "base" %}
