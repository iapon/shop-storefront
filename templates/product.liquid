    {%- capture gallery_map -%}{"product":[{%- for ph in product.photos -%}{{ ph.url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- for v in pv_vars -%},"{{ v.id }}":[{%- for ph in v.photos -%}{{ ph.url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endfor -%}}{%- endcapture -%}
    <script type="application/json" data-gallery-map>{{ gallery_map }}</script>
    {%- endif -%}
    <div class="product-info">
      <h1 class="product-title">{{ product.title }}</h1>
