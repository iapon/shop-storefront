{%- comment -%}
  register.liquid — страница регистрации (GET /register; POST обрабатывает
  сценарий register — адаптация пресета: аккаунт создаётся сразу, затем сценарий
  шлёт письмо-подтверждение; для письма владельцу нужен SMTP — см. чек-лист
  установки). register=taken / check_email=1 в query — подсказки после redirect.
  member-контур живёт на КОРНЕ сайта; noindex (персональный контур).
{%- endcomment -%}
{%- include "partials/ui-text" -%}
{%- assign page_title = t_register_title -%}
{%- assign page_canon = "/register" -%}
{%- assign page_noindex = true -%}
{%- capture content -%}
<div class="shop-container section-y auth-narrow">
  <div class="status-screen" style="padding-left:0;padding-right:0;">
    <span class="status-badge brand" aria-hidden="true">🛍️</span>
    {%- if member and member.id -%}
      <h1 class="status-title">{{ t_register_already }}</h1>
      <p class="status-text">{{ t_register_already_text }}</p>
      <div class="status-actions"><a class="btn btn-primary btn-lg" href="/account">{{ t_header_account }}</a></div>
    {%- else -%}
      <h1 class="status-title">{{ t_register_title }}</h1>
      <p class="status-text">{{ t_register_subtitle }}</p>
      {%- if query.register == "taken" -%}
        <p class="form-error" data-visible role="alert">{{ t_register_taken }} <a href="/login">{{ t_to_login }}</a>.</p>
      {%- elsif query.check_email == "1" -%}
        <p class="status-text" data-visible>{{ t_register_check_email }}</p>
      {%- endif -%}
      <form class="auth-form" method="post" action="/register" novalidate>
        <div class="field">
          <label class="field-label" for="rg-email">{{ t_field_email }}</label>
          <input class="field-input" id="rg-email" name="email" type="email" required autocomplete="email" placeholder="{{ t_ph_email }}">
        </div>
        <div class="field">
          <label class="field-label" for="rg-password">{{ t_field_password }}</label>
          <input class="field-input" id="rg-password" name="password" type="password" required minlength="6" autocomplete="new-password">
          <p class="field-hint">{{ t_register_pwd_hint }}</p>
        </div>
        <button class="btn btn-primary btn-lg" type="submit">{{ t_register_submit }}</button>
      </form>
      <p class="field-hint" style="margin-top:1rem;">{{ t_register_have_account }} <a href="/login">{{ t_to_login }}</a>.</p>
    {%- endif -%}
  </div>
</div>
{%- endcapture -%}
{% include "base" %}
